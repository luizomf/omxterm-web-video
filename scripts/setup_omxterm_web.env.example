# Copy this file, edit the copy, then validate and run it:
#   cp setup_omxterm_web.env.example setup.local.env
#   ./setup_omxterm_web --check setup.local.env
#   ./setup_omxterm_web setup.local.env

# Required deployment-specific values.
OMXTERM_PUBLIC_HOSTNAME='terminal.example.com'
OMXTERM_ACME_EMAIL='admin@example.com'
OMXTERM_SSH_ALLOWED_CIDRS='10.100.0.2/32,10.100.0.4/32,10.100.0.8/32'

# Optional paths and source branch.
OMXTERM_APP_DIR='/projects/omxterm-web'
OMXTERM_EDGE_DIR='/projects/omxterm-edge'
OMXTERM_DEPLOY_BRANCH='main'

# Optional Docker edge network. Keep the fixed application IP outside the
# dynamic allocation range so UFW can match it after container recreation.
OMXTERM_EDGE_NETWORK_NAME='omxterm-web-edge'
OMXTERM_EDGE_SUBNET='10.210.0.0/24'
OMXTERM_EDGE_IP_RANGE='10.210.0.128/25'
OMXTERM_EDGE_GATEWAY='10.210.0.1'
OMXTERM_APP_EDGE_IP='10.210.0.10'

# Optional host/proxy settings.
OMXTERM_HOST_SSH_PORT='22'
OMXTERM_TRAEFIK_IMAGE='traefik:v3.7.12@sha256:9c2a54d87f76f5c2f5f2682c68394af92fb12c0a2686798d6462a3f84bd78eaf'
OMXTERM_TRAEFIK_PROJECT='omxterm-edge'
OMXTERM_RATE_LIMIT_AVERAGE='20'
OMXTERM_RATE_LIMIT_BURST='40'
OMXTERM_RATE_LIMIT_PERIOD='1s'
